#!/bin/sh
#
# Install first-boot secrets from the FAT boot partition (mounted on /boot) into the rootfs.
#
#   /boot/wpa_supplicant.conf            -> /etc/wpa_supplicant.conf   (optional, Wi-Fi)
#   /boot/{cups,tc}.{uri,trust,crt,key}  -> /etc/station/              (Basics Station)
#   /boot/provision.{secret,url}         -> /etc/gateway-provision/    (zero-touch provisioning)
#   /boot/health.{endpoint,crt,key}      -> /etc/gwmon-health/         (gwmon's health reports)
#   /boot/tunnel.{cert.pem,key.pem,endpoint,thing}
#                                        -> /etc/aws-iot-device-client/{cert.pem,key.pem,endpoint,thing}
#                                                                      (remote shell, issue #15)
#
# provision.secret and provision.url are written by scripts/flash-gateway.ps1 (issue #10). With
# them, a gateway needs no cups.* files on the card: /usr/sbin/gateway-provision, started by
# S45gateway-provision, uses the secret once to fetch them from the provisioning function.
#
# health.endpoint, health.crt and health.key are the AWS IoT identity gwmon-publish.sh uses to
# publish gwmon's health report (issue #13). scripts/create-health-thing.sh writes them. It is a
# certificate of its own, not Station's.
#
# Each file is installed with mode 0600 and then deleted from the boot partition, so the secret is
# kept in one place only. Files that are not on the boot partition are left as they are in /etc,
# so this does nothing on later boots. Only file names are logged, never contents.
#
# Runs before S40network and S41wifi, so Wi-Fi and Basics Station find their files in place.
#
# This file was partially generated using Claude Code using the chat sessions at:
# Link to chat session (issue #5): https://claude.ai/code/cshk_01CSAPnyKYshomy4KcvdEtyKAXn5vdMngjU3SW9R1aadXg
# Link to chat session (issue #10): https://claude.ai/code/cshk_01CSAPnw19XXA81xkir2Ei316vsRvZPpL3YkJGDGzNdFWr
# Link to chat session (issue #13): ISSUE13_SESSION_LINK
# Link to chat session (issue #15): ISSUE15_SESSION_LINK

# PROVISION_BOOT is for testing the script against a copy of the boot files.
BOOT=${PROVISION_BOOT:-/boot}
WIFI_CONF=/etc/wpa_supplicant.conf
STATION_DIR=/etc/station
STATION_FILES="cups.uri cups.trust cups.crt cups.key tc.uri tc.trust tc.crt tc.key"
PROVISION_DIR=/etc/gateway-provision
HEALTH_DIR=/etc/gwmon-health
# The AWS IoT Device Client (secure tunneling only, S99tunnel) refuses to start unless its
# certificate directory is 700, the key 600 and the certificate 644.
TUNNEL_DIR=/etc/aws-iot-device-client
TUNNEL_FILES="cert.pem key.pem endpoint thing"

log() {
	echo "provision: $*"
	logger -t provision "$*"
}

# install_secret SRC DST [text]
# "text" strips the DOS line endings and the UTF-8 byte order mark that Windows tools add;
# wpa_supplicant rejects a file that starts with one. Certificates and keys are copied byte for
# byte: they may be DER, and a Basics Station token in tc.key ends in CRLF on purpose.
BOM=$(printf '\357\273\277')
install_secret() {
	src=$1
	dst=$2
	if [ "$3" = text ]; then
		tr -d '\r' < "$src" | sed "1s/^$BOM//" > "$dst.new"
	else
		cat "$src" > "$dst.new"
	fi
	if [ $? -ne 0 ] || ! chmod 600 "$dst.new" || ! mv "$dst.new" "$dst"; then
		rm -f "$dst.new"
		log "FAILED to install $dst, leaving $src in place"
		return 1
	fi
	rm -f "$src" || log "could not delete $src"
	log "installed $dst"
}

start() {
	# New files must never be readable by other users, even for a moment.
	umask 077

	grep -q " $BOOT " /proc/mounts || mount "$BOOT" 2>/dev/null
	if ! grep -q " $BOOT " /proc/mounts; then
		log "$BOOT is not mounted, nothing to install"
		return 0
	fi

	mkdir -p "$STATION_DIR"
	chmod 700 "$STATION_DIR"

	[ -f "$BOOT/wpa_supplicant.conf" ] && install_secret "$BOOT/wpa_supplicant.conf" "$WIFI_CONF" text

	for f in $STATION_FILES; do
		[ -f "$BOOT/$f" ] || continue
		case "$f" in
			*.uri) install_secret "$BOOT/$f" "$STATION_DIR/$f" text ;;
			*) install_secret "$BOOT/$f" "$STATION_DIR/$f" ;;
		esac
	done

	# The per-gateway provisioning secret and the address of the provisioning function.
	if [ -f "$BOOT/provision.secret" ] || [ -f "$BOOT/provision.url" ]; then
		mkdir -p "$PROVISION_DIR"
		chmod 700 "$PROVISION_DIR"
		for f in secret url; do
			[ -f "$BOOT/provision.$f" ] && install_secret "$BOOT/provision.$f" "$PROVISION_DIR/$f" text
		done
	fi

	# The health publisher's endpoint, certificate and key. The endpoint is a host name.
	if [ -f "$BOOT/health.endpoint" ] || [ -f "$BOOT/health.crt" ] || [ -f "$BOOT/health.key" ]; then
		mkdir -p "$HEALTH_DIR"
		chmod 700 "$HEALTH_DIR"
		[ -f "$BOOT/health.endpoint" ] && install_secret "$BOOT/health.endpoint" "$HEALTH_DIR/endpoint" text
		for f in crt key; do
			[ -f "$BOOT/health.$f" ] && install_secret "$BOOT/health.$f" "$HEALTH_DIR/$f"
		done
	fi

	# The remote-shell client's own thing: certificate, key, endpoint and thing name (issue #15).
	mkdir -p "$TUNNEL_DIR"
	chmod 700 "$TUNNEL_DIR"
	for f in $TUNNEL_FILES; do
		[ -f "$BOOT/tunnel.$f" ] || continue
		case "$f" in
			*.pem) install_secret "$BOOT/tunnel.$f" "$TUNNEL_DIR/$f" ;;
			*) install_secret "$BOOT/tunnel.$f" "$TUNNEL_DIR/$f" text ;;
		esac
	done
	# The certificate is public; the client wants it world-readable.
	[ -f "$TUNNEL_DIR/cert.pem" ] && chmod 644 "$TUNNEL_DIR/cert.pem"
	sync
	return 0
}

case "$1" in
	start|restart|reload)
		start
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
