#!/bin/sh
#
# Start Wi-Fi on wlan0 with wpa_supplicant and get an address with udhcpc.
#
# Credentials never live in the repo. /etc/init.d/S35provision installs /etc/wpa_supplicant.conf from
# the FAT boot partition before this script runs. With no such file, Wi-Fi is skipped and the
# gateway uses Ethernet only.
#
# This script was partially generated using Claude Code using the chat sessions at:
# Link to chat session (issue #1): https://claude.ai/code/cshk_01CSAPnyaYmJc1hcbrUg8bScPJ4y3B8gaWrv83AucuEYdA
# Link to chat session (issue #5): https://claude.ai/code/cshk_01CSAPnyKYshomy4KcvdEtyKAXn5vdMngjU3SW9R1aadXg

IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
WPA_PID=/var/run/wpa_supplicant.${IFACE}.pid
DHCP_PID=/var/run/udhcpc.${IFACE}.pid

wait_for_iface() {
	# eudev loads brcmfmac; give the firmware a few seconds to bring up wlan0.
	n=0
	while [ ! -d /sys/class/net/$IFACE ] && [ $n -lt 10 ]; do
		[ $n -eq 0 ] && modprobe brcmfmac 2>/dev/null
		sleep 1
		n=$((n + 1))
	done
	[ -d /sys/class/net/$IFACE ]
}

do_start() {
	if [ ! -f "$CONF" ]; then
		echo "wifi: no $CONF, skipping (put wpa_supplicant.conf on the boot partition)"
		return 0
	fi
	if ! wait_for_iface; then
		echo "wifi: $IFACE not found"
		return 1
	fi
	printf "Starting wifi on %s: " "$IFACE"
	# -s: log to syslog, so the report below can include the association log.
	start-stop-daemon -S -q -p "$WPA_PID" --exec /usr/sbin/wpa_supplicant -- \
		-B -s -D nl80211 -i "$IFACE" -c "$CONF" -P "$WPA_PID"
	# -b: go to the background if there is no lease yet, so boot doesn't block.
	udhcpc -i "$IFACE" -b -S -p "$DHCP_PID" >/dev/null 2>&1
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

# The gateway runs headless, so write the network state to the boot partition, where it can be
# read on a laptop if the Pi never shows up on the network. No credentials are logged.
report() {
	{
		echo "== aesd-net.log, uptime $(cut -d' ' -f1 /proc/uptime) s"
		echo "== ip addr"; ip addr
		echo "== ip route"; ip route
		echo "== iw dev"; iw dev
		echo "== iw $IFACE link"; iw dev "$IFACE" link
		echo "== $CONF present: $([ -f "$CONF" ] && echo yes || echo no)"
		echo "== dmesg (wifi)"; dmesg | grep -i -E 'brcm|wlan|cfg80211|ieee80211|firmware'
		echo "== syslog (wpa_supplicant, udhcpc)"; grep -E 'wpa_supplicant|udhcpc' /var/log/messages | tail -n 60
	} > /boot/aesd-net.log 2>&1
	sync
}

start() {
	do_start
	ret=$?
	(sleep 30; report) >/dev/null 2>&1 &
	return $ret
}

stop() {
	printf "Stopping wifi on %s: " "$IFACE"
	[ -f "$DHCP_PID" ] && kill "$(cat "$DHCP_PID")" 2>/dev/null
	start-stop-daemon -K -q -p "$WPA_PID"
	rm -f "$DHCP_PID" "$WPA_PID"
	echo "OK"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
