# This file was partially generated using Claude Code using the chat session at:
# Link to chat session (issue #15): ISSUE15_SESSION_LINK
config BR2_PACKAGE_AWS_IOT_DEVICE_CLIENT
	bool "aws-iot-device-client (secure tunneling only)"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_AWS_IOT_DEVICE_SDK_CPP_V2
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_CA_CERTIFICATES # the AWS IoT endpoint's CA, at run time
	help
	  The AWS IoT Device Client, built with every feature except
	  secure tunneling compiled out. With it a support engineer can
	  open an AWS IoT secure tunnel and reach the gateway's SSH
	  server from another network, while the gateway opens no
	  inbound port (issue #15).

	  Installs /usr/bin/aws-iot-device-client, the respawn loop
	  /usr/bin/tunnel-run.sh and the init script S99tunnel. The
	  client's certificate, key, endpoint and thing name are not in
	  the image: S35provision installs them from the boot partition
	  into /etc/aws-iot-device-client. Without them nothing starts.

	  https://github.com/awslabs/aws-iot-device-client

comment "aws-iot-device-client needs a toolchain w/ C++, threads, dynamic library"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
