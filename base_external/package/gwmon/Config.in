config BR2_PACKAGE_GWMON
	bool "gwmon"
	depends on BR2_USE_MMU # fork()
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Gateway monitor daemon for the AESD Pi 5 LoRaWAN gateway.
	  Version 1 serves one status line per connection on TCP
	  port 9000 and feeds the hardware watchdog (/dev/watchdog).
	  Installs /usr/bin/gwmon and /etc/init.d/S99gwmon. The
	  source is in gwmon/ at the top of this repository.

comment "gwmon needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS
