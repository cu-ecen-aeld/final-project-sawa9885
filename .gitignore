# Wi-Fi settings. wpa_supplicant.conf.example is the template and stays tracked.
wpa_supplicant.conf

# Basics Station credentials, under the names the gateway expects.
cups.uri
cups.trust
cups.crt
cups.key
tc.uri
tc.trust
tc.crt
tc.key

# The same files under the names AWS IoT Core gives them, and any other certificate or key.
*.pem
*.key
*.crt
*.trust

# The per-gateway provisioning secret and the address that flash-gateway.ps1 writes to a card (issue #10).
provision.secret
provision.url

# Build output of provisioning/deploy.sh and Python caches.
provisioning/build/
__pycache__/
