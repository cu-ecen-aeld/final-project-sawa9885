== gcc AddressSanitizer + LeakSanitizer + UndefinedBehaviorSanitizer build
gcc  -g -O1 -fno-omit-frame-pointer -Wall -Wextra -Werror -fsanitize=address,undefined -fno-sanitize-recover=undefined -std=gnu11 -pthread -c -o gwmon.o gwmon.c
gcc -g -O1 -fno-omit-frame-pointer -Wall -Wextra -Werror -fsanitize=address,undefined -fno-sanitize-recover=undefined -std=gnu11 -pthread  -o gwmon gwmon.o 
./test/host-test.sh ./gwmon
